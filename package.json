{
  "name": "xrp-payguard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "viem": "2.55.11"
  },
  "scripts": {
    "toolchain:check": "node tooling/preflight.mjs",
    "docs:check": "node tooling/check-docs.mjs",
    "secret:scan": "node tooling/scan-secrets.mjs",
    "bindings:generate": "node tooling/generate-bindings.mjs",
    "bindings:check": "node tooling/check-bindings.mjs",
    "privacy:scan": "node tooling/privacy-scan.mjs",
    "evidence:check": "node tooling/check-evidence.mjs",
    "release:check": "node tooling/check-release.mjs",
    "release:test": "node --test tooling/check-release.test.mjs",
    "deploy:coston2:plan": "node tooling/coston2-deploy.mjs plan",
    "deploy:coston2:test": "node --test tooling/coston2-deploy.test.mjs",
    "deploy:coston2": "node tooling/coston2-deploy.mjs deploy --broadcast",
    "deploy:coston2:verify": "node tooling/coston2-deploy.mjs verify",
    "fcc:container:smoke": "node tooling/fcc-container-smoke.mjs",
    "fcc:container:test": "node --test tooling/fcc-container.test.mjs",
    "fcc:image:repro": "node tooling/fcc-image-repro.mjs",
    "fcc:foundation:plan": "node tooling/fcc-foundation-deploy.mjs plan",
    "fcc:foundation:deploy": "node tooling/fcc-foundation-deploy.mjs deploy --broadcast",
    "fcc:foundation:verify": "node tooling/fcc-foundation-deploy.mjs verify",
    "fcc:foundation:test": "node --test tooling/fcc-foundation-registration.test.mjs",
    "fcc:machine:preflight": "cd apps/fcc-extension && go run ./cmd/machine-preflight",
    "fcc:machine:preflight:test": "cd apps/fcc-extension && go test ./internal/admission ./cmd/machine-preflight",
    "check": "pnpm toolchain:check && pnpm docs:check && pnpm secret:scan && pnpm privacy:scan && pnpm evidence:check && pnpm release:check && pnpm release:test && pnpm deploy:coston2:test && pnpm fcc:container:test && pnpm fcc:foundation:test && pnpm fcc:machine:preflight:test && pnpm bindings:check"
  }
}
