    "fcc:version:verify": "node tooling/fcc-code-version-deploy.mjs verify",
    "fcc:version:test": "node --test tooling/fcc-code-version.test.mjs tooling/fcc-code-version-deploy.test.mjs",
    "fcc:machine:plan": "node tooling/fcc-machine-registration.mjs plan",
    "fcc:machine:register": "node tooling/fcc-machine-registration.mjs register --broadcast",
    "fcc:machine:verify": "node tooling/fcc-machine-registration.mjs verify",
    "fcc:machine:registration:test": "node --test tooling/fcc-machine-registration.test.mjs",
    "fcc:result:test": "node --test tooling/fcc-foundation-result.test.mjs",
    "fcc:ping:plan": "node tooling/fcc-foundation-ping.mjs plan",
    "fcc:ping:send": "node tooling/fcc-foundation-ping.mjs send --broadcast",
    "fcc:ping:test": "node --test tooling/fcc-foundation-ping.test.mjs",
    "check": "pnpm toolchain:check && pnpm docs:check && pnpm secret:scan && pnpm privacy:scan && pnpm evidence:check && pnpm web:evidence:test && pnpm release:check && pnpm release:test && pnpm deploy:coston2:test && pnpm coston2:dependencies:test && pnpm coston2:endpoints:test && pnpm coston2:direct-mint:test && pnpm fcc:container:test && pnpm fcc:foundation:test && pnpm fcc:machine:preflight:test && pnpm fcc:version:test && pnpm fcc:machine:registration:test && pnpm fcc:result:test && pnpm fcc:ping:test && pnpm bindings:check"
  }
