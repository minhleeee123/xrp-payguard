{
  "name": "xrp-payguard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "toolchain:check": "node tooling/preflight.mjs",
    "docs:check": "node tooling/check-docs.mjs",
    "secret:scan": "node tooling/scan-secrets.mjs",
    "bindings:generate": "node tooling/generate-bindings.mjs",
    "bindings:check": "node tooling/check-bindings.mjs",
    "privacy:scan": "node tooling/privacy-scan.mjs",
    "evidence:check": "node tooling/check-evidence.mjs",
    "release:check": "node tooling/check-release.mjs",
    "release:test": "node --test tooling/check-release.test.mjs",
    "check": "pnpm toolchain:check && pnpm docs:check && pnpm secret:scan && pnpm privacy:scan && pnpm evidence:check && pnpm release:check && pnpm release:test && pnpm bindings:check"
  }
}
