    "coston2:dependencies:observe": "node tooling/coston2-dependency-resolution.mjs observe",
    "coston2:dependencies:record": "node tooling/coston2-dependency-resolution.mjs observe --write",
    "coston2:endpoints:test": "node --test tooling/coston2-public-endpoints.test.mjs",
    "coston2:direct-mint:test": "node --test tooling/coston2-direct-mint-observation.test.mjs",
    "coston2:endpoints:observe": "node tooling/coston2-public-endpoints.mjs observe",
    "coston2:endpoints:record": "node tooling/coston2-public-endpoints.mjs observe --write",
    "fcc:container:smoke": "node tooling/fcc-container-smoke.mjs",
    "fcc:container:test": "node --test tooling/fcc-container.test.mjs",
    "fcc:image:repro": "node tooling/fcc-image-repro.mjs",
